{
    "project": {
        "name": "my_project",
        "version": "1.0.0",
        "entry": "main.oboe",
        "description": "description goes here", // Optional
        "author": "author", // Optional
        "license": "license", // Optional
        "repository": "https://github.com/you/my_project", // Optional
        "homepage": "https://example.org", // Optional
        // "vivlijotiki" (a library, installed with `oboe get`) or "pawi"
        // (a tool, installed with `oboe install`). Defaults to vivlijotiki.
        "kind": "vivlijotiki"
    },

    // Registry for get/install/publish. A --registry flag and then
    // OBOE_REGISTRY both take precedence over this.
    "registry": "katare://sushipi.dreamstation.systems/",
    "build": { // Optional, everything in here is also optional. See SPEC.md for details.
        "output": "bin/main",
        "target": "linux",
        "compiler": "gcc",
        "desktop": true,
        "meta": { // Program metadata. The older flat "meta-name" etc. keys still work.
            "name": "My Project",
            "description": "description goes here",
            "version": "1.0.0",
            "icon": "myicon.ico"
        },
        "targets": { // Optional named build configs. `oboe build` builds every one of
                     // them in turn; `oboe build -t windows` builds just that one.
                     // Each may set any build field and inherits the rest from above.
                     // A config with no "target" targets the OS it is named after.
            "linux": {
                "output": "dist/my_project",
                "desktop": true
            },
            "windows": {
                "output": "dist/my_project.exe"
            },
            "portable": {
                "target": "linux",
                "output": "dist/my_project-portable",
                "desktop": false
            }
        }
    },
    // Fetched by `oboe get` and `oboe tidy`. Values are version constraints:
    // =X.Y.Z, >=X.Y.Z, ^X.Y.Z or *. The exact versions actually resolved are
    // pinned in .oboe/lock, which is meant to be committed.
    "dependencies": {
        "oboe": ">=1.0.0", // Added on init: the toolchain, not a package
        "some_library": "^1.0.0"
    }
}