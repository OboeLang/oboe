//
// Diagnostics. eprint + os.exit is exactly the shape the C compiler's
// codegen_error() has: message on stderr, non-zero status, no exception
// machinery wrapped around it.
import os

var SOURCE_NAME = "<input>"

func set_source(str name) {
    SOURCE_NAME = name
}

func fail(int line, str msg) {
    eprint("${SOURCE_NAME}:${str(line)}: error: ${msg}")
    os.exit(1)
}
