// Emits C for the mini-Oboe subset. Every value is a C `long`; strings exist
// only as `print` arguments, which is enough to keep the spike honest about
// escaping without dragging in a value representation.
import fail from diag

// output accumulates as pieces joined once at the end: `out = out + s` in a
// loop is quadratic, and this is the discipline the real port has to keep
var PIECES = []
var DECLARED = []

func emit(str s) {
    PIECES.push(s)
}

func c_escape(str s) {
    var out = []
    for (ch in s) {
        var n = ord(ch)
        if (ch == "\"") { out.push("\\\"") }
        else if (ch == "\\") { out.push("\\\\") }
        else if (ch == "\n") { out.push("\\n") }
        else if (ch == "\t") { out.push("\\t") }
        else if (n < 32 or n == 127) { out.push("\\${str(n / 64 % 8)}${str(n / 8 % 8)}${str(n % 8)}") }
        else { out.push(ch) }
    }
    return out.join("")
}

func gen_expr(e) {
    var k = e["kind"]
    if (k == "int") { return e["value"] }
    if (k == "ident") { return e["name"] }
    if (k == "neg") { return "(-${gen_expr(e["operand"])})" }
    if (k == "not") { return "(!${gen_expr(e["operand"])})" }
    if (k == "binary") {
        return "(${gen_expr(e["l"])} ${e["op"]} ${gen_expr(e["r"])})"
    }
    if (k == "call") {
        var parts = []
        for (a in e["args"]) { parts.push(gen_expr(a)) }
        return "mo_${e["name"]}(${parts.join(", ")})"
    }
    if (k == "str") {
        fail(0, "a string is only usable as a print argument")
    }
    fail(0, "cannot generate expression of kind '${k}'")
}

func indent(int n) {
    return " ".repeat(n)
}

func gen_stmt(s, int depth) {
    var pad = indent(depth * 4)
    var k = s["kind"]

    if (k == "let") {
        // a re-declared name is a plain assignment, so the subset does not need
        // block scoping to stay valid C
        if (DECLARED.contains(s["name"])) {
            emit("${pad}${s["name"]} = ${gen_expr(s["init"])};\n")
        } else {
            DECLARED.push(s["name"])
            emit("${pad}long ${s["name"]} = ${gen_expr(s["init"])};\n")
        }
        return null
    }
    if (k == "assign") {
        emit("${pad}${s["name"]} = ${gen_expr(s["value"])};\n")
        return null
    }
    if (k == "return") {
        var v = s["value"] == null ? "0" : gen_expr(s["value"])
        emit("${pad}return ${v};\n")
        return null
    }
    if (k == "print") {
        var fmt = []
        var vals = []
        for (a in s["args"]) {
            if (a["kind"] == "str") {
                fmt.push(c_escape(a["value"]))
            } else {
                // the cast is meaningful because an int-typed C expression passed
                // to a %ld vararg is read as 8 bytes and comes out garbage
                fmt.push("%ld")
                vals.push("(long)(${gen_expr(a)})")
            }
        }
        var tail = vals.len() == 0 ? "" : ", ${vals.join(", ")}"
        emit("${pad}printf(\"${fmt.join(" ")}\\n\"${tail});\n")
        return null
    }
    if (k == "if") {
        emit("${pad}if (${gen_expr(s["cond"])}) {\n")
        gen_body(s["then"], depth + 1)
        emit("${pad}}\n")
        if (s["else"].len() > 0) {
            emit("${pad}else {\n")
            gen_body(s["else"], depth + 1)
            emit("${pad}}\n")
        }
        return null
    }
    if (k == "while") {
        emit("${pad}while (${gen_expr(s["cond"])}) {\n")
        gen_body(s["body"], depth + 1)
        emit("${pad}}\n")
        return null
    }
    if (k == "break" or k == "continue") {
        emit("${pad}${k};\n")
        return null
    }
    if (k == "expr") {
        emit("${pad}(void)(${gen_expr(s["expr"])});\n")
        return null
    }
    fail(0, "cannot generate statement of kind '${k}'")
}

func gen_body(array body, int depth) {
    for (s in body) { gen_stmt(s, depth) }
}

func generate(array decls) {
    PIECES = []
    emit("/* generated by mini-oboe */\n#include <stdio.h>\n\n")

    var has_main = false
    for (d in decls) {
        if (d["name"] == "main") { has_main = true }
        var ps = []
        for (p in d["params"]) { ps.push("long ${p}") }
        var sig = ps.len() == 0 ? "void" : ps.join(", ")
        emit("long mo_${d["name"]}(${sig});\n")
    }
    if (!has_main) { fail(0, "no 'main' function") }
    emit("\n")

    for (d in decls) {
        var ps = []
        DECLARED = []
        for (p in d["params"]) {
            ps.push("long ${p}")
            DECLARED.push(p)
        }
        var sig = ps.len() == 0 ? "void" : ps.join(", ")
        emit("long mo_${d["name"]}(${sig}) {\n")
        gen_body(d["body"], 1)
        emit("    return 0;\n}\n\n")
    }

    emit("int main(void) { return (int)mo_main(); }\n")
    return PIECES.join("")
}
