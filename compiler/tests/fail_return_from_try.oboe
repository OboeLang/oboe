//
// Returning out of a try used to leave its exception frame on ob_exc_stack
// after the C frame died, so a later throw with no live try longjmp'd into
// freed memory and segfaulted instead of reporting itself.
func early() {
    try {
        return "early return from try"
    } catch (Exception e) {
        return "not reached"
    }
}

func main(array args) {
    print(early())
    throw ValueError("escaped")
}
