func main(array args) {
    print(6 & 3)
    print(6 | 3)
    print(6 ^ 3)
    print(~6)
    print(1 << 4)
    print(256 >> 2)
    print(0 - 8 >> 1)

    // unsigned values shift in zeros
    uint8 u = 200
    print(u >> 1)
    print(~u)

    // precedence: shifts bind tighter than comparison, & ^ | looser than ==
    print(1 << 3 == 8)
    print((4 | 1) == 5)
    print(6 & 3 | 8)
    print(1 | 2 ^ 3 & 3)
}
