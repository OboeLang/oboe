// cimport FFI: call into libc, whose soname differs per OS, so the cimports
// live in _libc.<os>.oboe. like events and operators they are global once that
// file is part of the program, so they are called here by bare name.
import _libc

func main(array args) {
    print(strlen("hello"))
    print(strlen(""))
    print(abs(-42))
}
