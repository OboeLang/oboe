//
// `var x` with no initializer used to read the next statement's leading
// identifier as its name, since `type name` is two bare identifiers.
func add(
    int a,
    int b
) {
    return a + b
}

func main(array args) {
    var v
    print("declaration does not eat this line")
    print(v)
    print(v == null)

    v = 5
    print(v)

    var unset
    var typed_later
    typed_later = "assigned later"
    print(unset)
    print(typed_later)

    // a type and name on one line is still a typed declaration
    int n = 7
    const var c = "const"
    print(add(n, 1))
    print(c)
}
