func main(array args) {
    var a = [3, 1, 2]
    print(a.len())
    a.push(4)
    print(a)
    print(a.pop(), a)
    print(a.contains(2), a.contains(9))
    print(a.index_of(1), a.index_of(9))
    print(a.join("-"))
    print(a.reverse(), a)
    print(a.slice(1, 3))
    a.insert(0, 99)
    print(a)
    print(a.remove_at(0), a)

    var d = {"b": 2, "a": 1}
    print(d.len())
    print(d.keys())
    print(d.values())
    print(d.has("a"), d.has("z"))
    print(d.contains("a"))
    print(d.remove("a"), d)

    // len() is shared across receiver types
    print("abc".len(), [1, 2].len(), {"k": 1}.len())
}
