// break/continue across every loop form, and out of a try nested in a loop --
// the case where the exception frame has to be popped before jumping.

func first_even(array xs) {
    for (x in xs) {
        if (x % 2 != 0) { continue }
        return x
    }
    return null
}

// breaking out of a try must leave ob_exc_stack where the loop found it, or the
// next throw longjmps into a dead stack slot
func find_bad(array xs) {
    var seen = []
    for (x in xs) {
        try {
            if (x == "stop") { break }
            seen.push(x.to_int())
        } catch (ValueError e) {
            seen.push(-1)
            continue
        }
    }
    return seen
}

func main(array args) {
    // while + break
    var i = 0
    while (true) {
        i = i + 1
        if (i >= 3) { break }
    }
    print("while:", i)

    // range for + continue
    var sum = 0
    for (n in range(0, 10)) {
        if (n % 3 != 0) { continue }
        sum = sum + n
    }
    print("range:", sum)

    // iterator for + break/continue
    print("first_even:", first_even([1, 3, 6, 7, 8]))

    // pairs + break
    var keys = []
    for (k, v in pairs({ "a": 1, "b": 2, "c": 3 })) {
        if (k == "c") { break }
        keys.push(k)
    }
    print("pairs:", keys.join(","))

    // break inside a switch case breaks the enclosing loop, since switch has no
    // fallthrough and so nothing to break out of on its own
    var hit = []
    for (n in range(0, 5)) {
        switch n {
            case 3 { break }
            case 1 { hit.push("one") }
            case 2 { hit.push("two") }
        }
        hit.push(str(n))
    }
    print("switch:", hit.join(","))

    // break/continue out of a try, then keep throwing afterwards to prove the
    // frame stack is still intact
    print("try:", find_bad(["1", "x", "2", "stop", "3"]).join(","))
    try {
        throw ValueError("still catchable")
    } catch (ValueError e) {
        print("after:", e)
    }

    // nested loops: the inner break leaves the outer one running
    var pairs_seen = []
    for (a in range(0, 3)) {
        for (b in range(0, 3)) {
            if (b == 1) { break }
            pairs_seen.push("${a}${b}")
        }
    }
    print("nested:", pairs_seen.join(","))
}
