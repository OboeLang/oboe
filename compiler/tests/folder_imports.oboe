// _folderlib/ declares itself as the project "shapes", so that is the name it
// is imported under; _plainfolder/ has no project.json and goes by its folder
// name, entering through main.oboe.
import shapes
import _plainfolder as plain

func main(array args) {
    print(shapes.area(10))
    print(shapes.area(10, 4))
    print(plain.shout("quiet"))
}
