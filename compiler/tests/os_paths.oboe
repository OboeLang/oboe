import os

func main(array args) {
    var file = os.script_file()
    var dir = os.script_dir()
    var root = os.project_root()

    print(file.ends_with("tests/os_paths.oboe"))
    print(file.starts_with("/"))
    print(dir.ends_with("/tests"))
    print(file.starts_with(dir))

    // no project.json above tests/, so project_root falls back to script_dir
    print(root == dir)
}
