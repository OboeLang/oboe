func takes8(int8 n) {
    return n
}

func main(array args) {
    // stores wrap into the declared width
    int8 a = 127
    a = a + 1
    print(a)
    int8 b = 200
    print(b)
    uint8 c = 200
    print(c)
    uint8 d = 300
    print(d)
    int16 e = 40000
    print(e)
    uint16 f = 70000
    print(f)

    // int is the unsized default and does not wrap on its own
    int plain = 200
    print(plain + 1)
    int64 big = 9223372036854775807
    print(big)

    // arithmetic promotes to the wider operand
    int8 small = 100
    int16 wider = small + small
    print(wider)
    print(small + small)

    // parameters coerce at entry
    print(takes8(300))

    // `is` asks whether the value fits the range
    print(127 is int8, 200 is int8, 200 is uint8, 0 - 1 is uint8)
    print(70000 is int16, 70000 is int32, 5 is int)
}
