// Lexer corpus for the selfhost_lexer gate -- never run, only tokenized, so it
// does not have to be a valid program. It collects the corners the real tests
// happen not to reach: custom operators against the builtins they shadow, every
// string escape, nested interpolation, the numeral/'.' ambiguity, exotic
// whitespace, raw control bytes and the full punctuation set.

// a declaration inside a comment still registers: operator <~>
operator ||> (int a, int b) { return a }
operator ||>= (int a, int b) { return a }
operator + (int a, int b) { return a }
operator_not_a_decl = 1
var shadowing = 1 ||>= 2 ||> 3 || 4 | 5 <~> 6

var escapes = "a\nb\tc\rd\\e\"f\$g\qh\0i"
var interp = "${a} ${ {"k": nested("}")} } tail ${b}"
var empty = ""
var high = "héllo ✓ ünïcødé"

var dotdot = 1..n
var member = 1.foo()
var real = 3.14
var lead0 = 007
var big = 9223372036854775807
var chain = 1.5.str()

var punct = a->b==c!=d<=e<<f>=g>>h&&i||j??k?.l?m:n
var rest = {}[](),.;+-*/%=<>!&|^~
var tabs=1
var crlf = 2
var ctrl = "xyzw"
