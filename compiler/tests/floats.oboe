import math

func main(array args) {
    float x = 1.5
    print(x)
    print(x + 1)
    print(x * 2)
    print(-x)

    // int / int stays integer division; a float operand makes it real
    print(7 / 2)
    print(7.0 / 2)
    print(7 / 2.0)
    print(7.5 % 2)

    // integral floats still read as floats
    print(2.0 + 2.0)
    print(1.0)

    // an int and a float compare by value
    print(1 == 1.0, 1 < 1.5, 2.0 > 1)

    // float32 rounds through single precision on store
    float64 wide = 0.1
    float32 narrow = 0.1
    print(wide == 0.1, narrow == 0.1)

    // is
    print(x is float, x is int, 1 is float, 1 is int)

    // truthiness
    print(!0.0, !0.5)

    // math goes floating point when any argument is
    print(math.sqrt(2), math.sqrt(2.0))
    print(math.abs(-2.5), math.min(1.5, 2), math.max(1.5, 2))
    print(math.floor(2.7), math.ceil(2.1), math.round(2.5))
    print(math.pow(2, 10), math.pow(2.0, 0.5))
}
